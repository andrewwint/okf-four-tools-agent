# secrets — NEVER commit. The news API key belongs in Amplify's secret store:
#   npx ampx sandbox secret set NEWS_API_KEY
# (the CLI prompts for the value; it should not pass through any other tool)
.env
.env.*
!.env.example

# deps
node_modules/

# amplify
.amplify/
amplify_outputs*.json
amplifyconfiguration*.json

# agentcore build artifacts
agentcore/.cli/
agentcore/cdk/cdk.out/
*.zip

# python
__pycache__/
*.pyc
.venv/

# data + build outputs (regenerated by the packaging step)
data/
*.parquet
build/
# benchmark results are committed — they are evidence, not build output

# misc
*.log
.DS_Store
dist/

# agentcore CLI working state — build cache, vendored deps, deploy logs. The staging dir
# contains platform wheels (a 52 MB duckdb .so) and must never be committed.
agentcore/.cache/
agentcore/.cli/
agentcore/.llm-context/
agentcore/cdk/node_modules/
agentcore/cdk/cdk.out/
agentcore/cdk/dist/
