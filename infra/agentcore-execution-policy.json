{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeExactlyOneModelViaTheUSInferenceProfile",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:us-east-1:790768631355:inference-profile/us.anthropic.claude-sonnet-4-5-20250929-v1:0",
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0",
        "arn:aws:bedrock:us-east-2::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0",
        "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-sonnet-4-5-20250929-v1:0"
      ]
    },
    {
      "Sid": "RetrieveFromExactlyOneKnowledgeBase",
      "Effect": "Allow",
      "Action": "bedrock:Retrieve",
      "Resource": "arn:aws:bedrock:us-east-1:790768631355:knowledge-base/U78LLZTZEL"
    },
    {
      "Sid": "InvokeExactlyOneNewsFunction",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:790768631355:function:amplify-okffourtoolsagent-an-getNewslambda832EFEA8-TYRI8OaXz1QH"
    },
    {
      "Sid": "RuntimeLogGroupDiscovery",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "arn:aws:logs:us-east-1:790768631355:log-group:*"
    },
    {
      "Sid": "RuntimeLogGroup",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:DescribeLogStreams"],
      "Resource": "arn:aws:logs:us-east-1:790768631355:log-group:/aws/bedrock-agentcore/runtimes/*"
    },
    {
      "Sid": "RuntimeLogStream",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:790768631355:log-group:/aws/bedrock-agentcore/runtimes/*:log-stream:*"
    },
    {
      "Sid": "WorkloadIdentity",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:GetWorkloadAccessToken",
        "bedrock-agentcore:GetWorkloadAccessTokenForJWT",
        "bedrock-agentcore:GetWorkloadAccessTokenForUserId"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:us-east-1:790768631355:workload-identity-directory/default",
        "arn:aws:bedrock-agentcore:us-east-1:790768631355:workload-identity-directory/default/workload-identity/okffourtools-*"
      ]
    },
    {
      "Sid": "MetricsNamespaceScoped",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": { "StringEquals": { "cloudwatch:namespace": "bedrock-agentcore" } }
    }
  ]
}
